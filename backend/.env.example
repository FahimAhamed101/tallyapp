MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/tally
PORT=4000

# Optional: override the resolvers used for the mongodb+srv:// SRV lookup.
# DNS_SERVERS=10.0.0.1,8.8.8.8

# Cloudinary — image uploads for customer/supplier avatars.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tallykhata

# How long a login token stays valid.
AUTH_TOKEN_TTL_DAYS=90
