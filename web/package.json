{
  "name": "tallykhata-web",
  "version": "1.0.0",
  "private": true,
  "description": "Next.js App Router port of the TallyKhata API + superadmin panel (RTK Query)",
  "scripts": {
    "clean": "rm -rf .next",
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "upload-check": "tsx scripts/upload-check.ts",
    "api-coverage": "tsx scripts/api-coverage.ts",
    "assertion-sanity": "tsx .smoke/assertion-sanity.ts",
    "consistency": "node .smoke/receivable-consistency.mjs",
    "unit-scope": "tsx .smoke/unit-scope.ts",
    "browser-check": "node .smoke/browser-check.mjs",
    "verify": "npm run typecheck && npm run smoke && npm run api-coverage && npm run upload-check && npm run assertion-sanity && npm run consistency && npm run unit-scope",
    "seed:stock": "tsx scripts/seed-stock.ts"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.7",
    "mongoose": "^8.6.0",
    "next": "14.2.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
