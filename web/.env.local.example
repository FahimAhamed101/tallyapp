# ---------------------------------------------------------------------------
# Copy to .env.local and fill in.
#
# The Next.js port reads and writes the SAME Atlas `tally` database as the
# Express backend, so the Android app and the panel see identical data.
# ---------------------------------------------------------------------------

# MongoDB Atlas connection string. The database name is pinned to `tally` in
# lib/mongodb.ts, so a URI without a path is fine too.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/tally

# Optional. Node's c-ares resolver points at 127.0.0.1 on some machines, which
# refuses the SRV lookup `mongodb+srv://` needs. lib/mongodb.ts defaults to
# 8.8.8.8 / 1.1.1.1; override here if you need a private resolver.
# DNS_SERVERS=10.0.0.1,8.8.8.8

# Cloudinary — image uploads for customer/supplier avatars.
# The secret is only ever read server-side; it never reaches a browser or the
# Android client.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tallykhata

# How long a login token stays valid.
AUTH_TOKEN_TTL_DAYS=90
